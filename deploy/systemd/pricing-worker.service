[Unit]
Description=Pricing App - generic worker (ventas-ml-rediseno, design D4)
Documentation=https://github.com/sernafernando/pricing-app
After=postgresql.service pricing-api.service
Wants=postgresql.service

# Paths, user and group are COPIED from the live pricing-api unit, not
# guessed: an invented path makes systemd refuse the unit with the
# unhelpful "unavailable resources or another system error".
[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/html/pricing-app/backend
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/var/www/html/pricing-app/backend/.env
ExecStart=/var/www/html/pricing-app/backend/venv/bin/python -m app.workers.run
Restart=always
RestartSec=5
# HeartbeatThread death detection (design D4 step 5) exits(70) precisely so
# this Restart=always policy picks the process back up -- never disable it.

[Install]
WantedBy=multi-user.target
