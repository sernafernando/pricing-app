.claude/

# Node.js
# No trailing slash on purpose: `node_modules/` matches directories ONLY, and in
# git worktrees this path is often a SYMLINK to a shared install. Git treats a
# symlink as a file, so the trailing-slash form left it untracked-but-visible,
# which leaked it into tooling that reads the working tree. Do not re-add it.
node_modules
dist/
.npm
.eslintcache
package-lock.json

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
